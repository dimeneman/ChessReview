# ==============================================================================
# ChessReview - EditorConfig Configuration
# ==============================================================================
# Standardizes formatting and indentation across different IDEs and editors.
# http://editorconfig.org
# ==============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Python sources
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# JavaScript / React / JSON
[*.{js,jsx,ts,tsx,json}]
indent_style = space
indent_size = 2

# Stylesheets
[*.{css,scss}]
indent_style = space
indent_size = 2

# Configuration and Documentation
[*.{yml,yaml,md,toml}]
indent_style = space
indent_size = 2

# Makefiles require genuine tab characters
[Makefile]
indent_style = tab

