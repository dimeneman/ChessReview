# ==============================================================================
# ChessReview - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# Do NOT commit actual secrets or production .env files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------
# Environment mode: development | staging | production | test
ENVIRONMENT=development

# Server binding host and port
HOST=0.0.0.0
PORT=8000

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Allowed CORS origins (comma-separated URLs, or * for permissive local dev)
# In production, set to your specific frontend domain(s), e.g.:
# CORS_ORIGINS=https://chessreview.vercel.app,http://localhost:3000
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# Chess Engine (Stockfish) Configuration
# ------------------------------------------------------------------------------
# Path to Stockfish UCI executable.
# In Docker / Debian Linux: /usr/games/stockfish
# In local development: backend/engine/stockfish (Linux/Mac) or backend/engine/stockfish.exe (Windows)
STOCKFISH_PATH=/usr/games/stockfish

# Path to the ECO chess openings JSON database
OPENINGS_JSON_PATH=backend/opening_books/openings.json

# Engine search depth parameters
# Higher depth increases precision at the cost of analysis latency
DEFAULT_DEPTH=18
DEFAULT_MULTIPV=3
MIN_DEPTH=5
MAX_DEPTH=25

# Brilliant move centipawn threshold and caps
BRILLIANT_CP_GAP=300
CP_LOSS_CAP=1000

# ------------------------------------------------------------------------------
# Frontend Service Configuration
# ------------------------------------------------------------------------------
# Base URL for Backend API requests
# Local Docker / development: http://localhost:8000
# Production deployment: https://chessreview-production.up.railway.app
VITE_API_URL=http://localhost:8000

# Frontend container exposed port (used by Docker Compose)
FRONTEND_PORT=3000

